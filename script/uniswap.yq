# Extract (chainId, <property>) pairs from a Uniswap deployments YAML and
# emit them as a comma-separated list of `(uint,address)` tuples.
#
# Usage:
#   property=PoolManager yq --from-file script/uniswap.yq script/uniswap.yml
. | to_entries
  | map(select(.value[strenv(property)] != null))
  | sort_by(.key | tonumber)
  | map("(" + .key + "," + .value[strenv(property)] + ")")
  | join(",")
